# Copier ce fichier en .env.local pour le développement, et renseigner les
# mêmes variables dans Vercel > Project > Settings > Environment Variables.

# Adresse publique du site, avec https:// (https://www.rachamarket.com).
# Tant qu'elle est vide, le site est servi en noindex.
NEXT_PUBLIC_SITE_URL=

# Supabase > Project Settings > API Keys.
# La clé publishable (ou « anon ») peut être exposée au navigateur : la sécurité
# repose sur les règles RLS définies dans supabase/migrations.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# E-mail « Nouvelle commande » (src/app/api/webhooks/nouvelle-commande).
# Serveur uniquement : ne jamais préfixer par NEXT_PUBLIC_.
# Secret partagé avec le webhook Supabase (Database > Webhooks), en-tête
# « Authorization: Bearer <secret> ».
ORDER_WEBHOOK_SECRET=
# Supabase > Project Settings > API Keys > Secret keys.
SUPABASE_SECRET_KEY=
# Resend > API Keys (accès « Sending » sur rachamarket.com).
RESEND_API_KEY=
# Destinataires, séparés par des virgules.
ORDER_NOTIFICATION_EMAILS=
